PORT=3000                         # Dashboard web port
HOST=0.0.0.0                      # Use 127.0.0.1 for local-only access
DATA_DIR=./data                   # SQLite database, generated secrets, logs, and bot runtime files

# Optional. If omitted, the app creates persistent secrets in DATA_DIR.
# SESSION_SECRET=change_me_to_a_long_random_string
# ENCRYPTION_KEY=base64_or_hex_32_byte_key

# Optional.
# SQLITE_PATH=./data/fnlb-dashboard.sqlite
# COOKIE_SECURE=false             # Set true only behind HTTPS

# Base URL used to build password reset links in emails.
# If omitted, the link is derived from the incoming request host.
# APP_URL=https://dashboard.example.com

# Password reset email (SMTP). If SMTP_HOST is omitted, reset links are
# printed to the server console instead of being emailed (good for local use).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                   # 465 for implicit TLS, 587 for STARTTLS
# SMTP_SECURE=false               # true for port 465
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM=FNLB Dashboard <no-reply@example.com>

# Bot values are saved per user in the dashboard, not in .env:
# Epic fnbr device auth / one-time auth code, local loadout config, legacy FNLB token/categories,
# NUMBER_OF_SHARDS, BOTS_PER_SHARD, RESTART_INTERVAL, CLUSTER_NAME
